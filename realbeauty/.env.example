# Real Beauty CRM — environment nusxasi. `.env` nomi bilan ko'chiring:
#   cp .env.example .env
# So'ng har bir qiymatni to'ldiring. .env hech qachon git'ga qo'shilmaydi.

# --- Server manzili (ENG MUHIM) ---
# Bu deploymentning yagona ommaviy hosti. Undan hamma narsa kelib chiqadi:
# ALLOWED_HOSTS, CSRF, nginx server_name, TLS sertifikat va Telegram Mini App
# manzili. Yangi serverga ko'chganda FAQAT shu qatorni o'zgartirasiz.
#
# Domen bo'lsa:      PUBLIC_HOST=crm.realbeauty.uz
# Domen bo'lmasa:    serverning IP si 1.2.3.4 bo'lsa -> 1-2-3-4.sslip.io
#                    (sslip.io to'g'ridan-to'g'ri o'sha IP ga yechiladi va
#                     Let's Encrypt unga sertifikat beradi)
PUBLIC_HOST=

# Let's Encrypt ogohlantirishlari shu manzilga keladi (sertifikat tugashidan
# oldin). docker/nginx/init-letsencrypt.sh shuni o'qiydi.
LETSENCRYPT_EMAIL=

# HTTPS tayyor bo'lgach True qiling — Django shundan keyingina HTTPS ga
# yo'naltiradi va cookie larni Secure qiladi. Sertifikat olinmaguncha False
# qoldiring, aks holda sayt ochilmay qoladi.
# Tartib: PUBLIC_HOST -> docker compose up -d -> init-letsencrypt.sh -> True.
TLS_ENABLED=False

# --- Django ---
# Kuchli kalit yarating:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=core.settings.prod
DEBUG=False
# Ixtiyoriy. Bo'sh qoldiring — Django PUBLIC_HOST ni ishlatadi. Faqat bir
# nechta domen bir vaqtda kerak bo'lsa to'ldiring (vergul bilan).
ALLOWED_HOSTS=

# React SPA (Vite) manzili(lari), vergul bilan. Lokal dev uchun standart qiymat
# yetarli — SPA production da nginx orqali xuddi shu hostdan beriladi, ya'ni
# CORS kerak emas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Telegram Mini App ---
# Ixtiyoriy va odatda BO'SH qoldiriladi: Django uni PUBLIC_HOST dan yasaydi
# (https://PUBLIC_HOST/webapp/), chunki nginx Mini App ni aynan o'sha yerda
# beradi. Faqat Mini App boshqa joyda hostlangan bo'lsa to'ldiring.
#
# DIQQAT: bu yerga eski serverning manzili yozilib qolsa, botdagi
# «Mahsulotlar» tugmasi o'lik manzilni ochadi — do'kon buzilgandek ko'rinadi.
# deploy.sh shu holatni tekshiradi va deploy ni to'xtatadi.
WEBAPP_URL=

# --- Postgres ---
POSTGRES_DB=realbeauty
POSTGRES_USER=realbeauty
# Kuchli parol:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Telegram bot ---
# @BotFather -> /newbot yoki /token. DIQQAT: token sirdir — chatga, git'ga,
# skrinshotga tushsa, @BotFather'da /revoke qilib yangisini oling.
BOT_TOKEN=
# Bot username @ belgisisiz (referal havolalar uchun)
BOT_USERNAME=

# --- Karta orqali to'lov (ixtiyoriy) ---
# @BotFather -> /mybots -> botni tanlang -> Payments -> provayder (Click yoki
# Payme) -> ulanganingizdan keyin BotFather token beradi.
# Bo'sh qoldirsangiz: karta to'lovi butunlay o'chiq — Mini App faqat
# "yetkazishda naqd" ni taklif qiladi, hech qanday hisob-faktura yuborilmaydi.
# Avval TEST tokenni sinang (ichida ":TEST:" bo'ladi), keyin jonli tokenni qo'ying.
PAYMENT_PROVIDER_TOKEN=

# --- Mobil ilova (Flutter) ---
# Ilova shu kalitni X-Api-Key header'da yuboradi (/api/app-users/register/,
# /api/auth/phone/request-code/, /api/auth/phone/verify-code/).
# Kuchli kalit yarating:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Ilova tomonidagi (real_beauty_ai) qiymat bilan bir xil bo'lishi shart.
APP_API_KEY=

# --- Eskiz.uz (ilovadagi telefon orqali kirish uchun SMS) ---
# https://eskiz.uz da ro'yxatdan o'ting, email/parolni shu yerga yozing.
# Diqqat: haqiqiy raqamlarga SMS yuborish uchun "from" nickname/shablon
# Eskiz tomonidan tasdiqlanishi kerak — tasdiqlanmaguncha faqat ularning
# test raqamiga (998900000000) yuboriladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SMS_FROM=4546

# --- Firebase Admin (OTP tasdiqlangach custom token yaratish uchun) ---
# Firebase Console → Project settings → Service accounts → Generate new
# private key. Yuklab olingan JSON faylni serverga qo'yib, shu yerga to'liq
# yo'lini yozing (masalan: /app/secrets/firebase-service-account.json).
# DIQQAT: bu fayl sir — git'ga hech qachon qo'shilmasin.
FIREBASE_SERVICE_ACCOUNT_JSON=
